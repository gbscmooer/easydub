# ===== 翻译 LLM（必配一项）=====
# 协议按 base_url 自动识别：含 "anthropic" 走 Anthropic 协议，否则走 OpenAI 兼容协议
# 方案 A：DeepSeek（推荐，OpenAI 兼容，注册即送额度）
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=
# 方案 B：复用 essay_read 的 MiMo（Anthropic 协议）
# LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/anthropic
# LLM_MODEL=claude-sonnet-4-6
# LLM_API_KEY=

# ===== TTS（三选一，--tts 指定）=====
# edge       免费，无需 key（默认）
# openrouter 网关 TTS 模型（免费档），复用 OPENROUTER_API_KEY
OPENROUTER_TTS_MODEL=fish-audio/s2.1-pro-free:free
# minimax    JD 指定，需 key
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# ===== lip-sync =====
# 自建 LatentSync 服务（Windows GPU 服务器），部署见 server/README_WINDOWS.md
LIPSYNC_SERVER_URL=http://192.168.1.100:8001
# sync.so 商用 API（可选对比通道）
SYNCSO_API_KEY=

# ===== ASR（二选一）=====
# openrouter = 云端转录（推荐：准、带字级时间轴，按秒计费很便宜）
ASR_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_ASR_MODEL=fish-audio/transcribe-1
# local = faster-whisper 本地（免费离线），tiny/base/small
# ASR_PROVIDER=local
ASR_MODEL_SIZE=base
